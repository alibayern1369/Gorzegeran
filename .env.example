# ─────────────────────────────────────────────────────────────
# لیگ گرز گران — نمونهٔ متغیرهای محیطی
# این فایل را به‌صورت .env.local کپی کنید و مقادیر را تغییر دهید
# ─────────────────────────────────────────────────────────────

# اتصال به PostgreSQL (سازگار با Neon، Supabase، Vercel Postgres و…)
# اگر تنظیم نشود، توسعه به‌صورت خودکار از PGlite محلی استفاده می‌کند
DATABASE_URL=postgres://user:password@host:5432/garz

# Neon direct connection for migrations (without -pooler in the hostname)
DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/garz

# مسیر دادهٔ PGlite برای توسعهٔ محلی (بدون DATABASE_URL)
# PGLITE_DATA_DIR=.pglite/data

# حساب مدیر لیگ (فقط برای ساخت اولیه در npm run db:seed)
# رمز عبور حداقل ۸ کاراکتر باشد؛ هرگز به‌صورت متن ساده ذخیره نمی‌شود
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-secure-password

# کلید امضای نشست‌ها — در تولید حتماً مقدار تصادفی قوی بگذارید (حداقل ۱۶ کاراکتر)
SESSION_SECRET=replace-with-a-long-random-secret

# نشانی عمومی برنامه (برای بررسی مبدأ درخواست‌ها)
NEXT_PUBLIC_APP_URL=https://your-domain.example
